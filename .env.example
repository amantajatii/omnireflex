# Testnet operator only. Never commit a real .env or private key.
# Preferred: cast wallet import reflex --interactive
ACCOUNT=
# SENDER=0xYourImportedWalletAddress
# Optional fallback when ACCOUNT is unset (never commit a real key):
PRIVATE_KEY=
REACTIVE_RPC_URL=https://lasna-rpc.rnk.dev/
UNICHAIN_SEPOLIA_RPC_URL=https://sepolia.unichain.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# All funding, fees and token quantities are integer base units (wei / 18-decimal token units).
# REACTIVE_FUNDING=500000000000000000
# EXECUTOR_FUNDING=20000000000000000
# EXECUTION_FEE=200000000000000
# MIN_AMOUNT_IN=10000000000000000
# ORDER_KIND=stop                    # stop | take | bracket | trail
# TRIGGER_CHAIN=1301                 # default: current destination chain
# TRIGGER_TICK=-80040                # required only for remote triggers; read script/status.sh there
# AMOUNT_IN=1000000000000000000      # rdETH input; default 1 rdETH
# DISTANCE_TICKS=200
# SLIPPAGE_BPS=500
# ORDER_TTL=86400                    # seconds
# DIRECTION=down                     # down | up, rdETH price in rdUSD
# AMOUNT=2000000000000000000         # down: rdETH units (default 2 rdETH)
# AMOUNT=6000000000000000000000      # up: rdUSD units (default 6000 rdUSD)
# REPLACE_EXECUTOR=1                # explicit replacement: drops old mirrors first; does not refund old orders
# FORCE=1                           # bypass conservative pool-count capacity guard
# LEGACY=1                          # use legacy transactions when required by RPC/network
